{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harbor.local/schemas/run-result.json",
  "title": "Harbor builder run result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "outcome",
    "waiting_on",
    "pr_url",
    "summary",
    "next_action",
    "blocker"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["completed", "waiting", "blocked", "failed"]
    },
    "outcome": {
      "type": ["string", "null"],
      "enum": ["merged", "pr_open", "parked", "no_pr", null]
    },
    "waiting_on": {
      "type": ["string", "null"],
      "enum": ["ci", "review", "human", "none", null]
    },
    "pr_url": {
      "type": ["string", "null"]
    },
    "summary": {
      "type": "string"
    },
    "next_action": {
      "type": ["string", "null"]
    },
    "blocker": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["kind", "question", "options", "recommendation", "recommended_option_index", "evidence"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "product_decision",
            "env_blocker",
            "github_transport",
            "ambiguous_ac",
            "missing_proof_capability",
            "conflicting_instruction"
          ]
        },
        "question": {"type": "string"},
        "options": {"type": "array", "items": {"type": "string"}},
        "recommendation": {"type": ["string", "null"]},
        "recommended_option_index": {
          "type": ["integer", "null"],
          "description": "Zero-based index into options of the recommended option (0 is the first option); null when there is no recommendation. Always set it when recommending: Harbor reads this index, not the recommendation text, to auto-accept the first option."
        },
        "evidence": {"type": ["string", "null"]}
      }
    }
  }
}
